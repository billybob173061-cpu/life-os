node_modules/

# Supabase CLI local state — regenerated by `supabase link`/`supabase start`,
# never source. linked-project.json in particular embeds the local machine's
# account/project identity, not something that belongs in version control.
supabase/.temp/
supabase/.branches/

# Secrets — never committed. Real AI Mentor / Tavily keys live only in
# Supabase Edge Function secrets (`supabase secrets set ...`), never in a
# file in this repo (see README "Where secrets belong").
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
